<Project>

    <!--
      Settings shared by everything under source/.
      Tooling under build/ is deliberately shielded from this file by build/Directory.Build.props:
      RefCheck and the SDK itself are plain net10.0 projects and must not inherit Revit or x64
      specifics. MSBuild stops at the first Directory.Build.props it finds walking up, so that
      file is enough to keep them separate.
    -->

    <PropertyGroup>
        <Configurations>Debug;Release</Configurations>
        <Platform>x64</Platform>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <!--
      Warnings are errors, and the baseline is zero because it already was.

      The rules document offers a ratchet for this - freeze the current count, fail only when it
      grows - and a ratchet is the right answer when there is a backlog to pay off. There is none:
      the whole solution builds with 0 warnings across all four Revit target frameworks. A bar set
      at zero today costs nothing and needs no machinery; set it in a year and it needs both.

      NoWarn stays the escape hatch, per project and per code, where a warning has been read and
      judged wrong. That is a decision with a name on it, which is the opposite of a global
      allowance nobody revisits.
    -->
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!--
      One version for everything under source/, and it moves with the change that earns it.
      Tooling under build/ is not covered - BHS.Revit.Sdk carries its own version, because that
      one is a compatibility contract with the projects naming it in their header.

      Only the source of truth lives here. AssemblyVersion and FileVersion are derived in
      Directory.Build.targets, where $(Version) already exists: deriving them here would read
      VersionPrefix directly and quietly ignore a `-p:Version=` on the command line, so a release
      build would ship a package saying 1.2.3 and assemblies still saying 0.1.0.
    -->
    <PropertyGroup>
        <VersionPrefix>0.1.0</VersionPrefix>
    </PropertyGroup>

    <PropertyGroup>
        <NeutralLanguage>en</NeutralLanguage>
        <SatelliteResourceLanguages>en-US;en-GB;ru-RU</SatelliteResourceLanguages>
    </PropertyGroup>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    </PropertyGroup>

    <!-- Vendor identity, used by the .addin manifest and the install paths. -->
    <PropertyGroup>
        <Company>BimHouse Software</Company>
        <Authors>alex@pototskiy.net</Authors>
        <RevitVendorId>BimHouseSoftware</RevitVendorId>
        <RevitVendorDescription>BimHouse Software by alex@pototskiy.net</RevitVendorDescription>
    </PropertyGroup>

    <!--
      The platform is kept OUT of the output path, and this is a correction rather than a
      preference.

      Left alone, the same project lands in two different places depending on how it is built:
      building the solution produces bin\Release\<tfm>\, while `dotnet run` on the project
      looks in bind\Release\<tfm>\. Both existed here, months apart in content, and every
      local probe run was executing whichever one happened to be newer - which is to say, not
      necessarily the one just built. CI found it the first time the second directory was absent,
      and the failure was a missing file rather than a stale result, which is the lucky version.

      Nothing is lost by dropping it: x64 is the only platform Revit has ever had, so the segment
      distinguished nothing and only made two spellings of one path.
    -->
    <PropertyGroup>
        <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    </PropertyGroup>

</Project>
