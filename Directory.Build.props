<Project>

    <!--
      Settings shared by everything under source/.
      Tooling under build/ is deliberately shielded from this file by build/Directory.Build.props:
      RefCheck and the SDK itself are plain net10.0 projects and must not inherit Revit or x64
      specifics. MSBuild stops at the first Directory.Build.props it finds walking up, so that
      file is enough to keep them separate.
    -->

    <PropertyGroup>
        <Configurations>Debug;Release</Configurations>
        <Platform>x64</Platform>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>

    <!--
      One version for everything under source/, and it moves with the change that earns it.
      Tooling under build/ is not covered - BHS.Revit.Sdk carries its own version, because that
      one is a compatibility contract with the projects naming it in their header.

      AssemblyVersion is deliberately frozen at the major and does NOT follow VersionPrefix.
      The reason is Revit 2024, where every add-in shares one AppDomain: two of our editions
      installed side by side have to resolve to ONE BHS.Logging.dll and ONE BHS.Revit.Host.dll,
      because LogRouter.Default and HostRegistry are built to be additive across editions - which
      is the whole point of making them idempotent rather than assuming "I am alone here".
      Distinct assembly versions would load both copies, each edition would get its own Default,
      and the additivity would quietly mean nothing.

      This is the same freeze CLAUDE.md flags as a hazard on Wpf.Ui, and the hazard is real: any
      build sharing the major claims the same identity. It is safe here only because our simple
      names carry the BHS. prefix, so no other vendor can land on them - the prefix earning its
      keep a second time.
    -->
    <PropertyGroup>
        <VersionPrefix>0.1.0</VersionPrefix>
        <AssemblyVersion>$([System.Version]::Parse('$(VersionPrefix)').Major).0.0.0</AssemblyVersion>

        <!--
          Stated, because the base SDK derives FileVersion from AssemblyVersion rather than from
          VersionPrefix - so freezing one silently freezes the other, and every build would look
          identical on disk. Measured: without this line the assemblies came out 0.0.0.0 in both.
          The file version is what a person reads off a deployed file to answer "is this the build
          I am debugging", and that question is the whole of rule 2.4.
        -->
        <FileVersion>$(VersionPrefix).0</FileVersion>
    </PropertyGroup>

    <PropertyGroup>
        <NeutralLanguage>en</NeutralLanguage>
        <SatelliteResourceLanguages>en-US;en-GB;ru-RU</SatelliteResourceLanguages>
    </PropertyGroup>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    </PropertyGroup>

    <!-- Vendor identity, used by the .addin manifest and the install paths. -->
    <PropertyGroup>
        <Company>BimHouse Software</Company>
        <Authors>alex@pototskiy.net</Authors>
        <RevitVendorId>BimHouseSoftware</RevitVendorId>
        <RevitVendorDescription>BimHouse Software by alex@pototskiy.net</RevitVendorDescription>
    </PropertyGroup>

    <!--
      The platform is kept OUT of the output path, and this is a correction rather than a
      preference.

      Left alone, the same project lands in two different places depending on how it is built:
      building the solution produces bin\Release\<tfm>\, while `dotnet run` on the project
      looks in bind\Release\<tfm>\. Both existed here, months apart in content, and every
      local probe run was executing whichever one happened to be newer - which is to say, not
      necessarily the one just built. CI found it the first time the second directory was absent,
      and the failure was a missing file rather than a stale result, which is the lucky version.

      Nothing is lost by dropping it: x64 is the only platform Revit has ever had, so the segment
      distinguished nothing and only made two spellings of one path.
    -->
    <PropertyGroup>
        <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    </PropertyGroup>

</Project>
