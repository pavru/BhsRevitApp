<Project>

    <!--
      Central Package Management. Versions live here and nowhere else: projects reference
      packages without a Version attribute, and CentralPackageVersionOverrideEnabled is false
      in Directory.Build.props so a project cannot quietly deviate.

      Revit API packages are NOT listed here. BHS.Revit.Sdk adds them implicitly and pins the
      version to the Revit target framework, so listing them centrally would fight the SDK.
    -->

    <ItemGroup>
        <!--
          Transport between Revit-side and Win-side. GrpcDotNetNamedPipes keeps the gRPC
          programming model and the .proto contracts but frames them over a named pipe instead of
          HTTP/2, which is what makes the transport work on Revit 2024: there is no gRPC server for
          .NET Framework at all.

          Google.Protobuf and Grpc.Core.Api arrive through it and are deliberately not pinned -
          Revit ships its own copies and pinning could only produce a downgrade (NU1605) whose
          suppression would later hide a real one. The check that our copies do not clash with
          Revit's is build/RefCheck, not a version here.
        -->
        <PackageVersion Include="Grpc.Tools" Version="2.83.0"/>

        <!--
          Direct now, because GrpcDotNetNamedPipes is no longer a package: it is vendored and
          rebuilt in source/Shared/BHS.Grpc.NamedPipes, and its readme says why. Pinning these two
          is not the pinning the note above warns against - the versions are exactly what the
          package resolved on its own, so nothing is downgraded and no NU1605 is being hidden.
        -->
        <PackageVersion Include="Google.Protobuf" Version="3.29.3"/>
        <PackageVersion Include="Grpc.Core.Api" Version="2.67.0"/>

        <!--
          4.5.4 is the package whose assembly version is 4.0.1.1 - the copy Revit 2024 ships, and
          the one Grpc.Core.Api and Google.Protobuf are built against. Referenced only on net48,
          where a second copy can exist at all. Both packages ask for 4.5.3 or later, so this is
          not a downgrade.
        -->
        <PackageVersion Include="System.Memory" Version="4.5.4"/>

        <!--
          The Revit-side UI set. Not referenced by anything yet; declared here so that the versions
          are decided once and in the open.

          WPF-UI is PINNED AT 4.0.3, and the pin is load-bearing. From 4.1.0 its net4x branch depends
          on the System.Memory package 4.6.3, whose assembly version is 4.0.5.0 - while Revit 2024
          ships 4.0.1.1 in its own directory, and that is the identity BHS.Grpc.NamedPipes was forked
          to match. Measured: with 4.1.0 the output carries 4.0.5.0 and the polyfill count goes from
          four to seven; with 4.0.3 all four polyfills come out identical to Revit's own copies, so
          there is nothing left to collide.

          Lift the pin when Revit 2024 leaves support, or when upstream drops the dependency -
          whichever comes first. Stated as a condition rather than a prohibition, because a
          prohibition with no expiry is one nobody dares to revisit.
        -->
        <PackageVersion Include="WPF-UI" Version="4.0.3"/>
        <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135"/>
        <PackageVersion Include="Lepo.i18n.Wpf" Version="2.0.0"/>

        <!-- Consuming a companion's configuration. Referenced only by the consuming half, so a
             project that merely publishes does not carry it into the Revit AppDomain. -->
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11"/>
    </ItemGroup>

</Project>
