<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    clear drops the machine-wide sources so a build here does not depend on what
    happens to be configured on the developer's machine. RepoFeed is produced by
    building build/BHS.Revit.Sdk; see its readme for the bootstrap step.
  -->
  <packageSources>
    <clear/>
    <add key="RepoFeed" value="artifacts\feed"/>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
  </packageSources>
</configuration>
