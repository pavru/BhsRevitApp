<Project>

    <!--
      Runs RefCheck after every Revit-side build.

      It was missing, and the gap is worth recording rather than quietly closing: build/RefCheck
      carries a complete RefCheck.targets, CLAUDE.md described RVTREF005 as a check that fails the
      build, and nothing imported the file. So the tool worked, the rule was written down, and it had
      never once run on its own - every finding this repository has from it came from somebody
      remembering to type the command.

      A check nobody imports is a check nobody runs. The targets file itself decides what applies to
      which project: RevitReferenceCheck turns on exactly where $(RevitVersion) is set, which is
      Revit-side projects and nothing else.
    -->
    <Import Project="$(MSBuildThisFileDirectory)build\RefCheck\RefCheck.targets"
            Condition="'$(RevitVersion)' != '' And Exists('$(MSBuildThisFileDirectory)build\RefCheck\RefCheck.targets')"/>

    <!--
      A feature's ribbon manifest travels with its Entry assembly, as a related file.

      The SDK writes <P>.Entry.features.json beside <P>.Entry.dll. An edition references the Entry
      project, and the edition's host builds the ribbon from the manifests in its own folder - so the
      file has to arrive there with the assembly it describes. Reference resolution already copies the
      files that share a referenced assembly's base name for the extensions listed here - .pdb and .xml
      are how everyone meets this - and a two-part extension is nothing new to it: .dll.config is on
      the default list.

      Measured on a throwaway pair of projects outside the tree, built with this file imported: the
      manifest arrived beside the Entry assembly in the referencing project's output and in its
      published Lib, on all four Revit target frameworks, with the referencing project naming no type
      from the Entry assembly at all. With .features.json left off the list it did not arrive.

      Seen again in the tree, with the two Entry projects it now holds: after a solution build,
      BHS.MEP.Cabling.Entry.features.json sits beside BHS.MEP.Cabling.Entry.dll in BHS.FullEdition's
      output and published Lib, and BHS.Revit.Probe.Entry.features.json beside its assembly in the
      probe's, on all four Revit target frameworks and byte for byte the file the Entry project wrote;
      `dotnet clean` on the edition removes the copy with the assembly, and the next build brings it
      back. Clean leaves the SDK's publish folder alone, as it always has; the next build replaces it.
      What a running host does with the manifest has not been measured: nothing here has run in Revit.

      Appended rather than set, and here rather than in Directory.Build.props: this file is imported
      after Microsoft.Common.CurrentVersion.targets has written the defaults, so appending keeps them.
      Set in props, the property would be non-empty when the defaults are considered and every .pdb
      and .xml would silently stop being copied.

      Revit-side only, like RefCheck above: a manifest means nothing to a project Revit never loads.
      No SDK change, and so no SDK version bump.
    -->
    <PropertyGroup Condition="'$(RevitVersion)' != ''">
        <AllowedReferenceRelatedFileExtensions>$(AllowedReferenceRelatedFileExtensions);.features.json</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>

    <!--
      And each culture overlay of it, <P>.Entry.features.<culture>.json, the same way - one extension per
      culture in RevitDeclarationCultures, derived rather than listed, so that the list the SDK checks
      culture files against and the list that delivers them cannot disagree. en-GB;ru-RU becomes
      .features.en-GB.json;.features.ru-RU.json.

      Unescaped, and that is bought: a property function's result comes back escaped, so its semicolons
      are %3B, and without Unescape the two extensions reached ResolveAssemblyReference as ONE - the
      English overlay found nothing, the Russian one was never looked for, and the build said nothing.
    -->
    <PropertyGroup Condition="'$(RevitVersion)' != '' And '$(RevitDeclarationCultures)' != ''">
        <AllowedReferenceRelatedFileExtensions>$(AllowedReferenceRelatedFileExtensions);$([MSBuild]::Unescape('.features.$(RevitDeclarationCultures.Trim().Trim(';').Replace(';', '.json;.features.')).json'))</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>

    <!--
      Assembly versions, derived here rather than in Directory.Build.props because $(Version) does
      not exist yet at that point - the SDK computes it from VersionPrefix later. Reading
      VersionPrefix directly would make `-p:Version=1.2.3` produce a package that says 1.2.3 and
      assemblies that still say 0.1.0.

      The two halves point in opposite directions on purpose.

      FileVersion moves with every version, because it is what a person reads off a deployed file
      to answer "is this the build I am debugging" - a question this repository has got wrong twice,
      once through a stale unpacked SDK and once through an assembly that went out unsigned in
      silence. The suffix is dropped: a file version is four numbers and takes no prerelease tag.

      AssemblyVersion is frozen at major.minor, and this is identity rather than bookkeeping. On
      Revit 2024 every add-in shares one AppDomain, so two of our editions installed side by side
      have to resolve to ONE BHS.Logging.dll and ONE BHS.Revit.Host.dll: LogRouter.Default and
      HostRegistry are built to be additive across editions, which means nothing at all if each
      edition loads its own copy. Frozen at major.minor rather than major alone because the major
      is still 0, where minor is what carries a breaking change - and because 0.0.0.0 is the value
      an assembly with no version set reports, which would make every Revit diagnostic naming one
      of ours say nothing.

      This is the same freeze CLAUDE.md flags as a hazard on Wpf.Ui, and the hazard is real: any
      build sharing major.minor claims the same identity. It is safe here only because our simple
      names carry the BHS. prefix, so no other vendor can land on them.
    -->
    <PropertyGroup Condition="'$(Version)' != ''">
        <_BhsNumericVersion>$(Version.Split('-')[0])</_BhsNumericVersion>
        <FileVersion Condition="'$(FileVersion)' == ''">$(_BhsNumericVersion).0</FileVersion>
        <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$([System.Version]::Parse('$(_BhsNumericVersion)').Major).$([System.Version]::Parse('$(_BhsNumericVersion)').Minor).0.0</AssemblyVersion>
    </PropertyGroup>

    <!--
      The PropertyGroup above is conditional, and a condition that silently does not fire is the
      shape of failure this repository keeps paying for: the derivation would simply not happen,
      the SDK defaults would take over, and the assemblies would carry an identity nobody chose.
      So say so out loud instead.
    -->
    <Target Name="BhsEnsureVersionDerived" BeforeTargets="GetAssemblyVersion"
            Condition="'$(_BhsNumericVersion)' == ''">
        <Error Code="BHSVER001"
               Text="Version was empty when Directory.Build.targets ran, so AssemblyVersion and FileVersion were never derived and the assembly would carry whatever the SDK defaulted to. See the comment above this target." />
    </Target>

</Project>
