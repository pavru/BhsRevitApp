<Project>
    <!-- ======================================================================================= -->
    <!-- Everything that turns a custom Revit moniker into a target framework the rest of the    -->
    <!-- toolchain accepts. This is the whole of the moniker support; there is no dispatcher.    -->
    <!--                                                                                        -->
    <!-- The moniker stays the real TargetFramework. `net48-revit2024` compiles, restores and    -->
    <!-- lands in bin\...\net48-revit2024\ under that name, and the base SDK's own               -->
    <!-- cross-targeting machinery drives the inner builds. An IDE therefore sees an ordinary    -->
    <!-- multi-targeting project: this file exists because the earlier design translated the     -->
    <!-- moniker and dispatched the real work into a child MSBuild call, which left Rider and    -->
    <!-- Visual Studio with an empty shell - no frameworks, no source files, no restore.         -->
    <!--                                                                                        -->
    <!-- Imported from Sdk.targets BEFORE the base Sdk.targets, which is the earliest point      -->
    <!-- where TargetFramework is known however it was supplied: as a global property from the   -->
    <!-- cross-targeting dispatcher or `dotnet build -f`, or from the project body. Properties   -->
    <!-- the base SDK would otherwise infer are all set here, which is what keeps                -->
    <!-- Microsoft.NET.TargetFrameworkInference.targets from choking on the `-revit` suffix.     -->
    <!-- ======================================================================================= -->

    <!--
      The supported matrix, in one place: one row per Revit release, `<year>=<plain moniker it is
      built on>`. Both the validation table and the list of platform versions below are derived
      from it, so adding a Revit release is one edit.
    -->
    <PropertyGroup>
        <RevitSupportedReleases Condition="'$(RevitSupportedReleases)' == ''">2024=net48;2025=net8.0;2026=net8.0;2027=net10.0</RevitSupportedReleases>
        <_RevitSupportedYears>$([System.Text.RegularExpressions.Regex]::Replace('$(RevitSupportedReleases)', '=[^;]*', ''))</_RevitSupportedYears>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' != '' And $(TargetFramework.Contains('-revit'))">
        <IsRevitTfm>true</IsRevitTfm>
        <RevitVersion>$([System.Text.RegularExpressions.Regex]::Match('$(TargetFramework)', `revit(\d+)`).Groups[1].Value)</RevitVersion>

        <!-- The plain moniker the Revit one is built on: net48, net8.0, net10.0. -->
        <_RevitBaseTfm>$(TargetFramework.Split('-')[0])</_RevitBaseTfm>

        <TargetFrameworkIdentifier>$([MSBuild]::GetTargetFrameworkIdentifier('$(_RevitBaseTfm)'))</TargetFrameworkIdentifier>
        <TargetFrameworkVersion>v$([MSBuild]::GetTargetFrameworkVersion('$(_RevitBaseTfm)', 2))</TargetFrameworkVersion>

        <!-- Both attributes would be stamped with a moniker no runtime has heard of. -->
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <GenerateSupportedRuntime>false</GenerateSupportedRuntime>

        <!--
          A Revit add-in is a class library that nothing references: Revit loads it by path from a
          folder it was copied into, and whatever is not in that folder is not there at run time.
          On the .NET axis a library does not copy its package dependencies to the output at all -
          only deps.json records them, and deps.json means nothing to a host that is not a .NET
          application. On .NET Framework the copy happens anyway, so this changes nothing there.

          Measured rather than reasoned about: the first probe deployed to Revit 2026 carried only
          its own assembly and BHS.Transport, and failed to load before a line of its code ran.
          Package assets that are reference-only - the Revit API packages themselves - stay out,
          because they are excluded from runtime assets and this copies only runtime assets.
        -->
        <CopyLocalLockFileAssemblies Condition="'$(CopyLocalLockFileAssemblies)' == ''">true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!--
      .NET Framework axis - Revit 2024.

      Nothing carries the release here, and that is deliberate. .NETFramework has no target
      platform, and the obvious substitute - putting `revit2024` in TargetFrameworkProfile - breaks
      every package that ships only netstandard assemblies, CommunityToolkit.Mvvm among them.
      NuGet maps netstandard onto .NETFramework only for a framework without a profile, so under
      `Profile=revit2024` the netstandard folder stops matching; and AssetTargetFallback does not
      rescue it, because the package's netstandard *dependency* group still matches and the package
      is therefore judged compatible, leaving an empty compile group instead of a fallback. Measured
      on one restore that targeted net48 and net48-revit2024 side by side: netstandard2.0 for the
      first, nothing for the second.

      Losing the profile costs only a label. Revit 2024 is the sole release on .NET Framework and
      always will be, so `net48-revit2024` has no sibling to be confused with; its identity is
      plain .NETFramework 4.8, and the moniker still names the output directory and the assets
      entry. The one combination it rules out - one project targeting `net48` and `net48-revit2024`
      at once - is meaningless anyway.
    -->
    <PropertyGroup Condition="'$(IsRevitTfm)' == 'true' And '$(TargetFrameworkIdentifier)' == '.NETFramework'">
        <!-- Packages are published for the plain moniker, never for ours. -->
        <AssetTargetFallback>$(AssetTargetFallback);$(_RevitBaseTfm)</AssetTargetFallback>

        <!-- On .NET Framework the compiler defaults to C# 7.3, so Nullable=enable fails with
             CS8630. A net48-revit moniker exists precisely to write modern code against an old
             framework, so the SDK supplies the language version rather than making every project
             repeat it. A default, not an override: a project that sets LangVersion keeps it.
             Note that `latest` only unlocks syntax - records, init accessors, indices and ranges
             still want a polyfill package on net48. -->
        <LangVersion Condition="'$(LangVersion)' == ''">latest</LangVersion>
    </PropertyGroup>

    <!--
      .NET axis - Revit 2025 and later.

      The Revit release is carried as the target platform: `revit`, versioned by the release year.
      That is what makes net8.0-revit2025 and net8.0-revit2026 different frameworks rather than two
      names for one. It matters beyond tidiness: an IDE keys its project model on the framework
      identity, and while the platform was `windows` both of them came out as
      `.NETCoreApp,Version=v8.0 / windows10.0.17763` - so Rider kept the first and dropped Revit
      2026 from the solution entirely.

      Declaring the release through the Windows SDK version instead - a different one per Revit
      release - would also produce distinct identities, and would be a coincidence rather than a
      fact: the moment two releases wanted the same Windows baseline, one of them would silently
      vanish again.

      The price is that we take Windows-ness upon ourselves, because the platform is no longer
      `windows`:

        TargetPlatformSupported          the base SDK only knows Windows and the workload
                                         platforms, and errors NETSDK1139 otherwise.
        SdkSupportedTargetPlatformVersion the sanctioned way to declare which platform versions
                                         exist; without it NETSDK1140 rejects the release year.
        ImportWindowsDesktopTargets      normally implied by a Windows platform. Without it the
                                         XAML markup compiler never runs and every code-behind
                                         fails on InitializeComponent. Switched on for the same
                                         projects the base SDK would have switched it on for -
                                         those asking for WPF or WinForms - because importing it
                                         for the rest warns NETSDK1106.
        AssetTargetFallback              the API packages publish under net8.0-windows7.0. The
                                         fallback names a Windows version high enough to also
                                         cover packages that ask for a specific Windows SDK; it is
                                         a ceiling for resolution, not a claim about the project.

      Revit.Platform.targets switches off the base-SDK behaviour that a Windows platform would have
      earned, and CA1418 below is the analyser noticing that `revit` is not a platform name it has
      heard of.
    -->
    <PropertyGroup Condition="'$(IsRevitTfm)' == 'true' And '$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
        <TargetPlatformIdentifier>revit</TargetPlatformIdentifier>
        <TargetPlatformVersion>$(RevitVersion).0</TargetPlatformVersion>
        <TargetPlatformSupported>true</TargetPlatformSupported>
        <ImportWindowsDesktopTargets Condition="'$(UseWPF)' == 'true' Or '$(UseWindowsForms)' == 'true'">true</ImportWindowsDesktopTargets>

        <AssetTargetFallback>$(AssetTargetFallback);$(_RevitBaseTfm)-windows10.0.22000.0;$(_RevitBaseTfm)</AssetTargetFallback>

        <!--
          Both are the platform analyser meeting a platform it has never heard of.

          CA1418 fires once per framework on the [SupportedOSPlatform("revit2026.0")] attribute the
          SDK generates for us.

          CA1416 fires on every call into anything annotated for Windows - "this call site is
          reachable on 'revit' 2026.0 and later; the member is only supported on 'Windows'" - and
          there is no way to tell the analyser that `revit` implies Windows. Revit-side code is
          Windows by definition, so there is no mistake here for the rule to catch.
        -->
        <NoWarn>$(NoWarn);CA1416;CA1418</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsRevitTfm)' == 'true' And '$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
        <_RevitSupportedYear Include="$(_RevitSupportedYears.Split(';'))"/>
        <SdkSupportedTargetPlatformVersion Include="@(_RevitSupportedYear->'%(Identity).0')"/>
    </ItemGroup>

    <!--
      NU1701 and NU1702, the notices that AssetTargetFallback was used, are suppressed in
      Before.Microsoft.NET.Sdk.props - they have to be, because NuGet records them once per
      project rather than per framework.

      NU1202 is deliberately NOT suppressed, although the previous design did. It needed to,
      because a translated moniker made genuinely incompatible packages look resolvable. With the
      moniker kept real NU1202 means what it says - the package has nothing for this framework -
      and hiding it would only defer the failure to run time.
    -->

    <!-- What the SDK made of the moniker, for when a build behaves in a way the project file does
         not explain. `dotnet build -p:RevitSdkDiagnostics=true`. -->
    <Target Name="_ReportRevitIdentity" BeforeTargets="BeforeBuild" Condition="'$(RevitSdkDiagnostics)' == 'true'">
        <Message Importance="high"
                 Text="[Revit SDK] $(MSBuildProjectName): tfm='$(TargetFramework)' revit='$(RevitVersion)' identity='$(TargetFrameworkIdentifier) $(TargetFrameworkVersion) $(TargetFrameworkProfile)' platform='$(TargetPlatformIdentifier) $(TargetPlatformVersion)' fallback='$(AssetTargetFallback)'"/>
    </Target>

    <!-- Implicit Revit API packages. Imported here rather than from the props files because it
         reads IsRevitTfm and RevitVersion, which are only known once TargetFramework is. -->
    <Import Project="$(MSBuildThisFileDirectory)Revit.Packages.targets" Condition="'$(IsRevitTfm)' == 'true' And Exists('$(MSBuildThisFileDirectory)Revit.Packages.targets')"/>

</Project>
