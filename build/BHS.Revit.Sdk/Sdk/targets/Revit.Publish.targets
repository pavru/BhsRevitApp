<Project>

    <!--
      Wrapper for Revit-Specific packages.
      Packages an add-in for a specific Revit version.
      Condition: PublishRevitAddIn is true, RevitVersion is defined, and RevitAddIn item exists.
    -->
    <Target Name="PublishRevitSpecificPackage"
            AfterTargets="_GenerateRevitAddInManifest"
            Condition="'$(PublishRevitAddIn)' == 'true' AND '$(RevitVersion)' != '' AND '@(RevitAddIn)' != ''">

        <Message Importance="High" Text="Publishing Revit-Specific package for Revit $(RevitVersion)..." />

        <!-- Validate required metadata -->
        <Warning Condition="'$(RevitVendorId)' == 'UnknownVendor'"
                 Text="The 'RevitVendorId' property is not set. Defaulting to 'UnknownVendor'. It is recommended to set this value in your project file." />

        <!--
          Properties, never item metadata. A %(...) reference inside a PropertyGroup batches the
          whole target, and this one begins by deleting the publish root: a project declaring two
          add-ins - an Application with a ribbon and a DBApplication beside it - would publish the
          first and then have it removed by the second pass. Found the day the second manifest was
          added, and it is not a case anyone would have thought to test for.

          The folder is a property of the package, not of an add-in, which is the deeper reason:
          one project builds one assembly and publishes one folder, whatever it declares inside.
          RevitPackageName is what the common package and both deploys already use, so this also
          removes a disagreement that was only invisible while AddInName happened to equal the
          assembly name - and stops a display name, which may contain anything, from naming a
          directory.
        -->
        <PropertyGroup>
            <_RevitPublishDirectoryNormalized>$([MSBuild]::NormalizeDirectory('$(RevitPublishDirectory)'))</_RevitPublishDirectoryNormalized>
            <_PublishRoot>$([System.IO.Path]::Combine('$(_RevitPublishDirectoryNormalized)', '$(RevitVersion)'))</_PublishRoot>
            <_AddInDestinationFolder>$(_PublishRoot)</_AddInDestinationFolder>
            <_VendorFolder>$([System.IO.Path]::Combine('$(_PublishRoot)', '$(RevitVendorId)'))</_VendorFolder>
            <_AddInFolder>$([System.IO.Path]::Combine('$(_VendorFolder)', '$(RevitPackageName)'))</_AddInFolder>
            <_PublishLibPath>$([System.IO.Path]::Combine('$(_AddInFolder)', 'Lib'))</_PublishLibPath>
            <_PublishResourcesPath>$([System.IO.Path]::Combine('$(_AddInFolder)', 'Resources'))</_PublishResourcesPath>
            <_PublishContentPath>$([System.IO.Path]::Combine('$(_AddInFolder)', 'Content'))</_PublishContentPath>
        </PropertyGroup>

        <ItemGroup>
            <_LibFilesToPublish Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)addin\**\*.*;$(TargetDir)publish\**\*.*" />
        </ItemGroup>

        <RemoveDir Directories="$(_PublishRoot)" Condition="Exists('$(_PublishRoot)')" />
        
        <MakeDir Directories="$(_AddInFolder)" />
        <MakeDir Directories="$(_PublishLibPath)" />
        <MakeDir Directories="$(_PublishResourcesPath)" Condition="'@(RevitAddInResources)' != ''" />
        <MakeDir Directories="$(_PublishContentPath)" Condition="'@(RevitAddInContent)' != ''" />

        <Copy SourceFiles="@(_LibFilesToPublish)" DestinationFolder="$(_PublishLibPath)%(RecursiveDir)" />
        <Copy SourceFiles="@(RevitAddInResources)" DestinationFolder="$(_PublishResourcesPath)%(RecursiveDir)" Condition="'@(RevitAddInResources)' != ''"/>
        <Copy SourceFiles="@(RevitAddInContent)" DestinationFolder="$(_PublishContentPath)%(RecursiveDir)" Condition="'@(RevitAddInContent)' != ''"/>

        <Copy SourceFiles="%(RevitAddIn.AddInOutputPath)" DestinationFolder="$(_AddInDestinationFolder)" />
        
        <Message Importance="High" Text="Revit-Specific package published to: $(_PublishRoot)" />
    </Target>

    <!--
      Wrapper for Revit-Common packages.
      Packages a set of shared libraries and resources, independent of Revit version.
      Condition: PublishRevitAddIn is true and RevitVersion is NOT defined.
    -->
    <!--
      IsRevitOuterBuild excludes the dispatching build of a Revit project. RevitVersion is only set
      in inner builds, so without it the outer build of a Revit-specific project looked like a
      common package and published a stray copy into bin\<platform>\<config>\<custom tfm>\publish.
      Non-Revit projects are unaffected: their inner builds have IsRevitOuterBuild false.
    -->
    <Target Name="PublishRevitCommonPackage"
            AfterTargets="Build"
            Condition="'$(PublishRevitAddIn)' == 'true' AND '$(RevitVersion)' == '' AND '$(IsRevitOuterBuild)' != 'true'">

        <Message Importance="High" Text="Publishing Revit-Common package..." />

        <!-- Validate required properties -->
        <Warning Condition="'$(RevitVendorId)' == 'UnknownVendor'"
                 Text="The 'RevitVendorId' property is not set. Defaulting to 'UnknownVendor'. It is recommended to set this property in your project file for common packages." />
        <Warning Condition="'$(RevitPackageName)' == '$(AssemblyName)'"
                 Text="The 'RevitPackageName' property is not set. Defaulting to the assembly name '$([System.IO.Path]::GetFileNameWithoutExtension('$(AssemblyName)'))'. It is recommended to set a unique package name in your project file." />

        <PropertyGroup>
            <_RevitPublishDirectoryNormalized>$([MSBuild]::NormalizeDirectory('$(RevitPublishDirectory)'))</_RevitPublishDirectoryNormalized>
            <_PublishRoot>$(_RevitPublishDirectoryNormalized)</_PublishRoot>
            <_VendorFolder>$([System.IO.Path]::Combine('$(_PublishRoot)', '$(RevitVendorId)'))</_VendorFolder>
            <_PackageFolder>$([System.IO.Path]::Combine('$(_VendorFolder)', '$(RevitPackageName)'))</_PackageFolder>
            <_AddInFolder>$(_PackageFolder)</_AddInFolder>
            <_PublishLibPath>$([System.IO.Path]::Combine('$(_AddInFolder)', 'Lib'))</_PublishLibPath>
            <_PublishResourcesPath>$([System.IO.Path]::Combine('$(_AddInFolder)', 'Resources'))</_PublishResourcesPath>
            <_PublishContentPath>$([System.IO.Path]::Combine('$(_AddInFolder)', 'Content'))</_PublishContentPath>
        </PropertyGroup>

        <ItemGroup>
            <_LibFilesToPublish Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)addin\**\*.*;$(TargetDir)publish\**\*.*" />
        </ItemGroup>

        <RemoveDir Directories="$(_AddInFolder)" Condition="Exists('$(_AddInFolder)')" />

        <MakeDir Directories="$(_AddInFolder)" />
        <MakeDir Directories="$(_PublishLibPath)" />
        <MakeDir Directories="$(_PublishResourcesPath)" Condition="'@(RevitAddInResources)' != ''" />
        <MakeDir Directories="$(_PublishContentPath)" Condition="'@(RevitAddInContent)' != ''" />

        <Copy SourceFiles="@(_LibFilesToPublish)" DestinationFolder="$(_PublishLibPath)%(RecursiveDir)" />
        <Copy SourceFiles="@(RevitAddInResources)" DestinationFolder="$(_PublishResourcesPath)%(RecursiveDir)" Condition="'@(RevitAddInResources)' != ''"/>
        <Copy SourceFiles="@(RevitAddInContent)" DestinationFolder="$(_PublishContentPath)%(RecursiveDir)" Condition="'@(RevitAddInContent)' != ''"/>

        <Message Importance="High" Text="Revit-Common package published to: $(_AddInFolder)" />
    </Target>

    <!--
      Deploy Target for Revit-Specific packages.
    -->
    <Target Name="DeployRevitSpecificPackage"
            AfterTargets="PublishRevitSpecificPackage"
            Condition="'$(RevitDeploy)' != '' AND '$(RevitVersion)' != ''">

        <Message Importance="High" Text="Deploying Revit-Specific package to $(RevitDeploy) scope..." />

        <Error Condition="'$(RevitDeploy)' != 'System' AND '$(RevitDeploy)' != 'Local'"
               Text="Invalid RevitDeploy scope for a Revit-Specific package. Valid values are: System, Local." />

        <PropertyGroup>
            <_RevitPublishDirectoryNormalized>$([MSBuild]::NormalizeDirectory('$(RevitPublishDirectory)'))</_RevitPublishDirectoryNormalized>
            <_PublishRoot>$([System.IO.Path]::Combine('$(_RevitPublishDirectoryNormalized)', '$(RevitVersion)'))</_PublishRoot>
            
            <_DeployDestinationRoot Condition="'$(RevitDeploy)' == 'System'">$(ProgramData)\Autodesk\Revit\Addins\$(RevitVersion)\</_DeployDestinationRoot>
            <_DeployDestinationRoot Condition="'$(RevitDeploy)' == 'Local'">$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</_DeployDestinationRoot>
        </PropertyGroup>

        <PropertyGroup>
            <_DeployAddInFolder>$([System.IO.Path]::Combine('$(_DeployDestinationRoot)', '$(RevitVendorId)', '$(RevitPackageName)'))</_DeployAddInFolder>
        </PropertyGroup>

        <!--
          Our own folder is emptied before the copy, and only ours: the Addins directory belongs to
          every vendor on the machine, while VendorId/PackageName under it is this package and
          nothing else.

          Deploy used to copy and never delete, so the folder accumulated whatever any past build
          had put there. Measured: add-in folders still held BHS.Configuration.dll and
          GrpcDotNetNamedPipes.dll from renames, and Microsoft.Extensions.* from the day that
          reference was removed - Revit was loading a directory no build had produced in weeks.
          Worse, RVTREF005 reads the build output rather than the deployed folder, so a forbidden
          assembly could outlive the rule that banned it.

          The probe runner already cleared the folder itself, which is the tell: it needed doing,
          and only the caller that had been bitten did it.

          ContinueOnError is not laziness here, it is the difference between a stale folder and a
          broken one. Rebuild with RevitDeploy=Local while Revit is open and the loaded assembly is
          mapped: Directory.Delete removes what it can and then throws, so without this the target
          fails AFTER emptying Lib and BEFORE the copy, and the next Revit start finds a half-erased
          add-in. With it, the copy still runs and restores everything it owns; the locked file
          keeps its old content, which is exactly what it kept before this clean existed.

          It also does not touch the manifests at the Addins root, and cannot: that directory holds
          every vendor's .addin, and a manifest we published under a name we no longer use is
          indistinguishable from somebody else's. Renaming an add-in still leaves its old manifest
          behind - known, and narrower than what it replaced.
        -->
        <RemoveDir Directories="$(_DeployAddInFolder)" Condition="Exists('$(_DeployAddInFolder)')"
                   ContinueOnError="WarnAndContinue" />

        <ItemGroup>
            <_DeployFiles Include="$(_PublishRoot)\**\*.*" />
        </ItemGroup>

        <Message Importance="Normal" Text="Copying files from $(_PublishRoot) to $(_DeployDestinationRoot)" />

        <Copy SourceFiles="@(_DeployFiles)" 
              DestinationFiles="@(_DeployFiles->'$(_DeployDestinationRoot)%(RecursiveDir)%(Filename)%(Extension)')" 
              SkipUnchangedFiles="true" />
              
        <!--
          Said out loud, because the alternative is silence in the one place where it costs a
          person time. An empty RevitSignWith means "production", so the signing target simply does
          not run - no error, no warning. That is correct for a release and wrong for a deploy: an
          unsigned add-in makes Revit raise a modal dialog before any add-in reaches OnStartup, and
          from outside the process that is indistinguishable from a Revit that is merely slow.
          Measured once already, when the thumbprint had been set for one terminal session only and
          builds quietly went out unsigned for a day.
        -->
        <Message Importance="High" Condition="'$(RevitSignWith)' == '' AND '@(RevitAddIn)' != ''"
                 Text="Deploy complete: $(_DeployDestinationRoot) - UNSIGNED. Revit will ask about this add-in unless it is already trusted by AddInId. Set BHS_REVIT_SIGN_WITH to sign." />
        <Message Importance="High" Condition="'$(RevitSignWith)' == '' AND '@(RevitAddIn)' == ''"
                 Text="Deploy complete: $(_DeployDestinationRoot)" />
        <!-- The last four characters, not the thumbprint: enough to tell one development certificate
             from another, and the repository is public, so build logs are too.

             Length-guarded, because Substring throws on a negative start and a thumbprint short
             enough to cause that is a mistyped environment variable - which would then fail the
             build from inside the SUCCESS message, naming Substring and not the variable. -->
        <PropertyGroup>
            <!--
              The stamp the signing target touches, which is the only evidence here that this build
              actually signed anything. Asking RevitSignWith alone says what was CONFIGURED, and the
              two come apart on an ordinary incremental build: signing hangs off CoreCompile, so
              with the sources unchanged it does not run, while the deploy does. The message would
              then report "signed" on a file this build never touched - a claim dressed as a
              measurement, which is the failure this whole change set is about.
              Absolute, and that is load bearing: Exists() resolves a relative path against the
              working directory of the build, not against the project, so the relative form was
              false whenever the build was started from anywhere but the project folder - which is
              always, since the solution lives one level up. Measured: the stamp was on disk and the
              message still said the build had not signed.
            -->
            <_RevitSignStamp>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)$(TargetFileName).$(RevitSignWith).signed</_RevitSignStamp>
        </PropertyGroup>

        <Message Importance="High" Condition="'$(RevitSignWith)' != '' AND '@(RevitAddIn)' != '' AND Exists('$(_RevitSignStamp)') AND $(RevitSignWith.Length) &gt; 4"
                 Text="Deploy complete: $(_DeployDestinationRoot) - signed with certificate ...$(RevitSignWith.Substring($([MSBuild]::Subtract($(RevitSignWith.Length), 4))))." />
        <Message Importance="High" Condition="'$(RevitSignWith)' != '' AND '@(RevitAddIn)' != '' AND Exists('$(_RevitSignStamp)') AND $(RevitSignWith.Length) &lt;= 4"
                 Text="Deploy complete: $(_DeployDestinationRoot) - signed, though RevitSignWith is only $(RevitSignWith.Length) characters and no thumbprint is that short." />
        <!--
          Only a project that declares an add-in is ever signed - Revit asks about the assembly its
          manifest names and about nothing else - so the ones that declare none say nothing about
          signatures. Without this they all reported "did not sign", which is true and useless, and
          drowns the one line that matters in four that never could have said anything else.
        -->
        <Message Importance="High" Condition="'$(RevitSignWith)' != '' AND '@(RevitAddIn)' != '' AND !Exists('$(_RevitSignStamp)')"
                 Text="Deploy complete: $(_DeployDestinationRoot) - signing is configured, but this build did not sign: the deployed file carries whatever signature it already had, or none." />
        <Message Importance="High" Condition="'$(RevitSignWith)' != '' AND '@(RevitAddIn)' == ''"
                 Text="Deploy complete: $(_DeployDestinationRoot)" />
    </Target>

    <!--
      Deploy Target for Revit-Common packages.
    -->
    <Target Name="DeployRevitCommonPackage"
            AfterTargets="PublishRevitCommonPackage"
            Condition="'$(RevitDeploy)' != '' AND '$(RevitVersion)' == '' AND '$(IsRevitOuterBuild)' != 'true'">

        <Message Importance="High" Text="Deploying Revit-Common package to $(RevitDeploy) scope..." />

        <Error Condition="'$(RevitDeploy)' != 'System' AND '$(RevitDeploy)' != 'Local'"
               Text="Invalid RevitDeploy scope for a Revit-Common package. Valid values are: System, Local." />

        <PropertyGroup>
            <_RevitPublishDirectoryNormalized>$([MSBuild]::NormalizeDirectory('$(RevitPublishDirectory)'))</_RevitPublishDirectoryNormalized>
            <_SourcePath>$([System.IO.Path]::Combine('$(_RevitPublishDirectoryNormalized)', '$(RevitVendorId)', '$(RevitPackageName)'))</_SourcePath>

            <_DeployDestinationRoot Condition="'$(RevitDeploy)' == 'System'">$(ProgramFiles)</_DeployDestinationRoot>
            <_DeployDestinationRoot Condition="'$(RevitDeploy)' == 'Local'">$(LocalAppData)</_DeployDestinationRoot>
        </PropertyGroup>

        <PropertyGroup>
            <_DeployAddInFolder>$([System.IO.Path]::Combine('$(_DeployDestinationRoot)', '$(RevitVendorId)', '$(RevitPackageName)'))</_DeployAddInFolder>
        </PropertyGroup>

        <!-- Same reason as the version-specific deploy above: ours only, emptied before the copy,
             and never failing the build over a file Revit happens to have mapped. -->
        <RemoveDir Directories="$(_DeployAddInFolder)" Condition="Exists('$(_DeployAddInFolder)')"
                   ContinueOnError="WarnAndContinue" />

        <ItemGroup>
            <_DeployFiles Include="$(_SourcePath)\**\*.*" />
        </ItemGroup>

        <Message Importance="Normal" Text="Copying files from $(_SourcePath) to $(_DeployDestinationRoot)\$(RevitVendorId)\$(RevitPackageName)" />

        <Copy SourceFiles="@(_DeployFiles)" 
              DestinationFolder="$([System.IO.Path]::Combine('$(_DeployDestinationRoot)', '$(RevitVendorId)', '$(RevitPackageName)'))\%(RecursiveDir)"
              SkipUnchangedFiles="true" />
              
        <Message Importance="High" Text="Deploy complete: $(_DeployDestinationRoot)\$(RevitVendorId)\$(RevitPackageName)" />
    </Target>

</Project>
