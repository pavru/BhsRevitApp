<Project>

    <UsingTask TaskName="BHS.Revit.Sdk.GenerateRevitDefineConstants" AssemblyFile="$(BuildTasksAssembly)"/>
    <UsingTask TaskName="BHS.Revit.Sdk.GenerateRevitAddIn" AssemblyFile="$(BuildTasksAssembly)"/>
    <UsingTask TaskName="BHS.Revit.Sdk.GenerateFeatureManifest" AssemblyFile="$(BuildTasksAssembly)"/>

    <ItemDefinitionGroup>
        <RevitAddIn>
            <Visible>false</Visible>
        </RevitAddIn>
    </ItemDefinitionGroup>

    <PropertyGroup>
        <PublishRevitAddIn Condition="'$(PublishRevitAddIn)' == ''">false</PublishRevitAddIn>
        <RevitFeatureManifestExtension Condition="'$(RevitFeatureManifestExtension)' == ''">.features.json</RevitFeatureManifestExtension>
        <!-- The cultures a declaration overlay may be written for. Empty accepts any; a repository that
             delivers overlays by related file extension should set it, and derive the extensions from it. -->
        <RevitDeclarationCultures Condition="'$(RevitDeclarationCultures)' == ''"></RevitDeclarationCultures>
        <DeployRevitAddIn Condition="'$(DeployRevitAddIn)' == ''">false</DeployRevitAddIn>

        <RevitVendorId Condition="'$(RevitVendorId)' == ''">UnknownVendor</RevitVendorId>
        <RevitPackageName Condition="'$(RevitPackageName)' == ''">$(AssemblyName)</RevitPackageName>
        <DeployRevitAddInScope Condition="'$(DeployRevitAddInScope)' == ''">Local</DeployRevitAddInScope>
        <RevitPublishDirectory Condition="'$(RevitPublishDirectory)' == ''">$(TargetDir)publish\</RevitPublishDirectory>
    </PropertyGroup>

    <Target Name="_GenerateRevitConstants"
            AfterTargets="AddImplicitDefineConstants"
            Condition="'$(RevitVersion)' != ''">
        <GenerateRevitDefineConstants
                RevitVersion="$(RevitVersion)"
                DefineConstants="$(DefineConstants)"
                MinSupportedVersion="2024">

            <Output TaskParameter="UpdatedDefineConstants" PropertyName="DefineConstants"/>
        </GenerateRevitDefineConstants>
    </Target>

    <Target Name="_GenerateRevitAddInManifest"
            AfterTargets="Build"
            Condition="'$(RevitVersion)' != '' And '@(RevitAddIn)' != ''">

        <!-- Defaults first. A metadata reference inside an item update element does not see a
             value assigned earlier in that same element, so _AssemblyPathForManifest, which reads
             Assembly, VendorId and AddInName, has to be computed in a later ItemGroup. Folding it
             into the block below silently produced an empty Assembly and the task rejected it. -->
        <ItemGroup>
            <RevitAddIn>
                <AddInOutputPath Condition="'%(Identity)' == ''">$(TargetDir)addin\$(AssemblyName).addin</AddInOutputPath>
                <AddInOutputPath Condition="'%(Identity)' != ''">$(TargetDir)addin\%(Identity)</AddInOutputPath>
                <Assembly Condition="'%(RevitAddIn.Assembly)' == ''">$(TargetFileName)</Assembly>
                <AddInName Condition="'%(RevitAddIn.AddInName)' == ''">$(AssemblyName)</AddInName>
                <VendorId Condition="'%(RevitAddIn.VendorId)' == ''">$(RevitVendorId)</VendorId>
            </RevitAddIn>
        </ItemGroup>

        <ItemGroup>
            <RevitAddIn>
                <_AssemblyPathForManifest Condition="'$(PublishRevitAddIn)' != 'true'">%(RevitAddIn.Assembly)</_AssemblyPathForManifest>
                <!-- Where the publish target actually puts the files, named the same way it names
                     them: by package, not by add-in. Several add-ins in one project share one Lib. -->
                <_AssemblyPathForManifest Condition="'$(PublishRevitAddIn)' == 'true'">$(RevitVendorId)\$(RevitPackageName)\Lib\%(RevitAddIn.Assembly)</_AssemblyPathForManifest>
            </RevitAddIn>
        </ItemGroup>

        <ItemGroup>
            <_RevitAddInTaskItem Include="%(RevitAddIn.AddInOutputPath)">
                <Assembly>%(_AssemblyPathForManifest)</Assembly>
                <FullClassName>%(RevitAddIn.FullClassName)</FullClassName>
                <AddInId>%(RevitAddIn.AddInId)</AddInId>
                <AddInName>%(RevitAddIn.AddInName)</AddInName>
                <VendorId>%(RevitAddIn.VendorId)</VendorId>
                <AddInType>%(RevitAddIn.AddInType)</AddInType>
                <Description>%(RevitAddIn.Description)</Description>
                <VendorDescription>%(RevitAddIn.VendorDescription)</VendorDescription>
                <VisibilityMode>%(RevitAddIn.VisibilityMode)</VisibilityMode>
                <AvailabilityClassName>%(RevitAddIn.AvailabilityClassName)</AvailabilityClassName>
                <LanguageType>%(RevitAddIn.LanguageType)</LanguageType>
                <LongDescription>%(RevitAddIn.LongDescription)</LongDescription>
                <TooltipImage>%(RevitAddIn.TooltipImage)</TooltipImage>
                <LargeImage>%(RevitAddIn.LargeImage)</LargeImage>
                <Image>%(RevitAddIn.Image)</Image>
                <AllowLoadIntoExistingSession>%(RevitAddIn.AllowLoadIntoExistingSession)</AllowLoadIntoExistingSession>
                <UnifyInAddInManager>%(RevitAddIn.UnifyInAddInManager)</UnifyInAddInManager>
                <UseRevitContext>%(RevitAddIn.UseRevitContext)</UseRevitContext>
                <ContextName>%(RevitAddIn.ContextName)</ContextName>
            </_RevitAddInTaskItem>
        </ItemGroup>

        <GenerateRevitAddIn
            AddInDefinition="@(_RevitAddInTaskItem)"
            RevitVersion="$(RevitVersion)"/>
    </Target>

    <!--
      The ribbon manifest: what the host reads to build buttons without loading the assemblies
      behind them. It goes next to the assembly, which for a published add-in means Lib - the same
      place the settings files land, and for the same reason: what belongs beside the assembly is
      found relative to the assembly, and everything a level up exists without being read.

      From 1.6.0 it also carries RevitDockablePane items: panes the host registers at startup and
      whose content class it constructs by name, the first time Revit asks for the pane.
    -->
    <!--
      Written straight into the output directory, and without Inputs/Outputs.

      Both decisions were bought by one silent failure. The first version wrote to obj and added a
      None item with CopyToOutputDirectory, which does nothing: the copy list is computed in
      AssignTargetPaths, long before a target that runs beside CopyFilesToOutputDirectory. And it was
      guarded by Inputs="$(MSBuildAllProjects)", a property modern SDKs leave empty - so the target
      was considered up to date and skipped, with no output and no message. Writing the file is a few
      hundred bytes of string building; it does not need protecting from itself.
    -->
    <Target Name="_GenerateFeatureManifest"
            AfterTargets="CopyFilesToOutputDirectory"
            Condition="'$(RevitVersion)' != '' And ('@(RevitRibbonButton)' != '' Or '@(RevitDockablePane)' != '')">

        <GenerateFeatureManifest
            Buttons="@(RevitRibbonButton)"
            Panes="@(RevitDockablePane)"
            Strings="@(RevitDeclarationStrings)"
            Cultures="$(RevitDeclarationCultures)"
            OutputPath="$(TargetDir)$(AssemblyName)$(RevitFeatureManifestExtension)"
            AssemblyFileName="$(TargetFileName)">

            <Output TaskParameter="CultureFiles" ItemName="_RevitFeatureManifestOverlay"/>
        </GenerateFeatureManifest>

        <ItemGroup>
            <!-- So that a clean removes them, like anything else the build produced. -->
            <FileWrites Include="$(TargetDir)$(AssemblyName)$(RevitFeatureManifestExtension)"/>
            <FileWrites Include="@(_RevitFeatureManifestOverlay)"/>
        </ItemGroup>
    </Target>

    <!--
      Declaration strings, from 1.6.5: the .resx a RevitDeclarationStrings item names, and the culture
      files beside it, are the source of the manifest's text and must not ALSO become resources.

      The base SDK globs every .resx into EmbeddedResource, and a culture file there becomes a satellite
      assembly - a folder of files beside an Entry assembly that is supposed to hold empty classes and
      nothing else, delivered to every edition for strings nobody reads through a ResourceManager: the
      manifest carries them already. So both are taken out, before the resource targets look.

      In a target rather than at evaluation, because the culture files are found by a wildcard beside the
      neutral one, and a wildcard is expanded only inside a target. Removed by full path, the one spelling
      both lists agree on whatever the project wrote - MatchOnMetadata, because a plain Remove compares
      item specs, and 'Strings\Declaration.resx' is not its own full path: 1.6.3 shipped that way and the
      culture file still became a satellite.
    -->
    <Target Name="_RemoveRevitDeclarationStringsFromResources"
            BeforeTargets="PrepareResourceNames;AssignTargetPaths"
            Condition="'@(RevitDeclarationStrings)' != ''">

        <ItemGroup>
            <_RevitDeclarationStringFile Include="@(RevitDeclarationStrings->'%(FullPath)')"/>
            <_RevitDeclarationStringFile Include="%(RevitDeclarationStrings.RootDir)%(RevitDeclarationStrings.Directory)%(RevitDeclarationStrings.Filename).*.resx"/>
        </ItemGroup>

        <ItemGroup>
            <EmbeddedResource Remove="@(_RevitDeclarationStringFile)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike"/>
        </ItemGroup>
    </Target>

</Project>
