<Project>

    <!--
      Validation runs before the build and before restore collects packages. Restore has to be
      covered too: the implicit Revit API references are versioned from the release in the moniker,
      so an unsupported release surfaces as NU1102 on a package that was never going to exist, long
      before the build could say anything more useful.

      Both checks read RevitSupportedReleases from Revit.Identity.targets, which holds the matrix as
      `<year>=<plain moniker>` rows. Adding a Revit release is one edit, there.
    -->
    <Target Name="_ValidateRevitTfmConfiguration" BeforeTargets="BeforeBuild;BeforeCompile;CollectPackageReferences" Condition="'$(IsRevitTfm)' == 'true'">

        <PropertyGroup>
            <_IsSupportedRevitVersion>false</_IsSupportedRevitVersion>
            <_IsSupportedRevitVersion Condition="$([System.String]::new(';$(RevitSupportedReleases);').Contains(';$(RevitVersion)='))">true</_IsSupportedRevitVersion>

            <!-- The pairing of Revit release and .NET version is fixed by Autodesk; there is no
                 free product of the two axes. -->
            <_IsNetVersionMismatch>true</_IsNetVersionMismatch>
            <_IsNetVersionMismatch Condition="$([System.String]::new(';$(RevitSupportedReleases);').Contains(';$(RevitVersion)=$(_RevitBaseTfm);'))">false</_IsNetVersionMismatch>

            <!-- What the release should have been built on, for the message. -->
            <_ExpectedBaseTfm>$([System.Text.RegularExpressions.Regex]::Match(';$(RevitSupportedReleases)', ';$(RevitVersion)=([^;]*)').Groups[1].Value)</_ExpectedBaseTfm>
            <_SupportedReleaseList>$([System.Text.RegularExpressions.Regex]::Replace('$(RevitSupportedReleases)', '=[^;]*', '').Replace(';', ', '))</_SupportedReleaseList>
        </PropertyGroup>

        <Error Condition="'$(_IsSupportedRevitVersion)' == 'false'"
               Text="[Revit SDK] Unsupported Revit version: '$(RevitVersion)'. The SDK only supports versions: $(_SupportedReleaseList)."/>

        <Error Condition="'$(_IsSupportedRevitVersion)' == 'true' And '$(_IsNetVersionMismatch)' == 'true'"
               Text="[Revit SDK] .NET version mismatch. Revit $(RevitVersion) requires '$(_ExpectedBaseTfm)', but '$(_RevitBaseTfm)' is being used."/>

    </Target>

</Project>
