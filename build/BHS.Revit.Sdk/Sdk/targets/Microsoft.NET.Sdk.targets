<Project>
    <!-- ======================================================================================= -->
    <!-- Dispatcher logic for Single-Targeting Outer Builds                                      -->
    <!-- ======================================================================================= -->

    <!-- We only dispatch if this is the outer build and TargetFramework is set (Single-targeting) -->
    <PropertyGroup Condition="'$(IsRevitOuterBuild)' == 'true' And '$(TargetFramework)' != ''">
        <_IsSingleTargetOuterBuild>true</_IsSingleTargetOuterBuild>
    </PropertyGroup>

    <!-- The TFM translation lives in Revit.TfmMapping.targets, shared with the cross-targeting
         and restore dispatchers. Here the map holds exactly one entry.

         Every dispatch below carries RemoveProperties="TargetFramework;TargetFrameworks". With
         `dotnet build -f net48-revit2024` the custom moniker arrives as a global property, and a
         project-level assignment cannot override one: the inner build would keep compiling under
         the custom moniker while its assets file is written for the translated one (NETSDK1005).
         Removing it lets Before.Microsoft.NET.Sdk.props set the translated framework instead. -->
    <Target Name="_PrepareSingleRevitDispatch"
            DependsOnTargets="_MapRevitTargetFrameworks"
            Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <PropertyGroup>
            <!--
              The framework goes over as _RevitInnerTargetFramework, never as TargetFramework, and
              TargetFrameworks is not passed at all. Both are global properties here, and global
              properties flow into every project reached through ProjectReference: a referenced
              library would evaluate and restore as whatever this project compiles as. See the note
              in Before.Microsoft.NET.Sdk.props, which turns it back into a project-level property.
            -->
            <_InnerBuildProperties>_IsInnerRevitBuild=true;_RevitInnerTargetFramework=@(_RevitTfmMap->'%(InnerTfm)');RevitInnerTfm=@(_RevitTfmMap->'%(OriginalTfm)')</_InnerBuildProperties>
        </PropertyGroup>
    </Target>
    <!-- Intercept core build targets -->
    <Target Name="Build" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks"/>
    </Target>

    <Target Name="Clean" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Clean" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks"/>
    </Target>

    <Target Name="Rebuild" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Rebuild" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks"/>
    </Target>

    <Target Name="Pack" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Pack" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks"/>
    </Target>

    <Target Name="Publish" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks"/>
    </Target>

    <!-- Design-Time Targets -->
    <Target Name="Compile" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Compile" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks"/>
    </Target>

    <Target Name="ResolveReferences" Returns="@(ReferencePath)" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="ResolveReferences" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks">
             <Output TaskParameter="TargetOutputs" ItemName="ReferencePath"/>
        </MSBuild>
    </Target>
    
    <Target Name="ResolveAssemblyReferences" Returns="@(ReferencePath)" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="ResolveAssemblyReferences" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks">
            <Output TaskParameter="TargetOutputs" ItemName="ReferencePath"/>
        </MSBuild>
    </Target>

    <Target Name="ResolveProjectReferences" Returns="@(_ResolvedProjectReferencePaths)" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="ResolveProjectReferences" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks">
            <Output TaskParameter="TargetOutputs" ItemName="_ResolvedProjectReferencePaths"/>
        </MSBuild>
    </Target>

    <Target Name="ResolvePackageDependenciesDesignTime" Returns="@(_DependenciesDesignTime)" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="ResolvePackageDependenciesDesignTime" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks">
            <Output TaskParameter="TargetOutputs" ItemName="_DependenciesDesignTime"/>
        </MSBuild>
    </Target>



    <Target Name="GetTargetPath" Returns="@(TargetPathWithTargetPlatformMoniker)" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="GetTargetPath" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks">
            <Output TaskParameter="TargetOutputs" ItemName="TargetPathWithTargetPlatformMoniker"/>
        </MSBuild>
    </Target>
    
    <Target Name="GetNativeManifest" Returns="@(NativeManifest)" DependsOnTargets="_PrepareSingleRevitDispatch" Condition="'$(_IsSingleTargetOuterBuild)' == 'true'">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="GetNativeManifest" Properties="$(_InnerBuildProperties)" RemoveProperties="TargetFramework;TargetFrameworks">
            <Output TaskParameter="TargetOutputs" ItemName="NativeManifest"/>
        </MSBuild>
    </Target>

</Project>
