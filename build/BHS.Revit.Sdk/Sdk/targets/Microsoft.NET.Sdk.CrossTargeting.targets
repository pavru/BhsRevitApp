<Project>
    <!-- ======================================================================================= -->
    <!-- Dispatcher logic for Multi-Targeting Outer Builds                                       -->
    <!-- Instead of the base SDK dispatching, WE dispatch and manipulate the TargetFramework     -->
    <!-- sent to the inner build, passing standard .NET targets to trick the inner base SDK.     -->
    <!-- ======================================================================================= -->

    <!-- The TFM translation itself lives in Revit.TfmMapping.targets so that both build
         dispatchers and the restore dispatcher share one table. -->
    <Target Name="_GetInnerTargetFrameworks" DependsOnTargets="_MapRevitTargetFrameworks"/>
    <!--
      Common outer-loop properties to pass to the inner build.

      Neither TargetFramework nor TargetFrameworks is passed. Everything here becomes a global
      property, and global properties flow into every project reached through ProjectReference:
      a referenced library would evaluate and restore as whatever this project compiles as, ending
      up with one wrong target (NETSDK1005) or none at all (MSB3992). The framework travels as
      _RevitInnerTargetFramework instead and Before.Microsoft.NET.Sdk.props turns it back into a
      project-level TargetFramework; Sdk.targets clears TargetFrameworks after the project body.
    -->
    <PropertyGroup>
        <_InnerBuildProperties>_IsInnerRevitBuild=true</_InnerBuildProperties>
    </PropertyGroup>

    <!-- Standard Build Targets -->
    <Target Name="Build" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)"/>
    </Target>

    <Target Name="Clean" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Clean" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)"/>
    </Target>

    <Target Name="Rebuild" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Rebuild" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)"/>
    </Target>

    <Target Name="Pack" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Pack" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)"/>
    </Target>

    <Target Name="Publish" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)"/>
    </Target>

    <!-- ============================================================================== -->
    <!-- Design-time build targets used by Visual Studio/Rider/NuGet                    -->
    <!-- These targets must return exactly what the IDE expects (Items and Properties)  -->
    <!-- ============================================================================== -->

    <Target Name="Compile" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Compile" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)"/>
    </Target>

    <Target Name="ResolveReferences" Returns="@(ReferencePath)" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="ResolveReferences" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)">
             <Output TaskParameter="TargetOutputs" ItemName="ReferencePath"/>
        </MSBuild>
    </Target>
    
    <Target Name="ResolveAssemblyReferences" Returns="@(ReferencePath)" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="ResolveAssemblyReferences" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)">
            <Output TaskParameter="TargetOutputs" ItemName="ReferencePath"/>
        </MSBuild>
    </Target>

    <Target Name="ResolveProjectReferences" Returns="@(_ResolvedProjectReferencePaths)" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="ResolveProjectReferences" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)">
            <Output TaskParameter="TargetOutputs" ItemName="_ResolvedProjectReferencePaths"/>
        </MSBuild>
    </Target>

    <Target Name="ResolvePackageDependenciesDesignTime" Returns="@(_DependenciesDesignTime)" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="ResolvePackageDependenciesDesignTime" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)">
            <Output TaskParameter="TargetOutputs" ItemName="_DependenciesDesignTime"/>
        </MSBuild>
    </Target>

    <Target Name="CollectPackageReferences" Returns="@(PackageReference)" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="CollectPackageReferences" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)">
            <Output TaskParameter="TargetOutputs" ItemName="PackageReference"/>
        </MSBuild>
    </Target>

    <Target Name="GetTargetPath" Returns="@(TargetPathWithTargetPlatformMoniker)" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="GetTargetPath" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)">
            <Output TaskParameter="TargetOutputs" ItemName="TargetPathWithTargetPlatformMoniker"/>
        </MSBuild>
    </Target>
    
    <Target Name="GetNativeManifest" Returns="@(NativeManifest)" DependsOnTargets="_GetInnerTargetFrameworks">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="GetNativeManifest" Properties="_RevitInnerTargetFramework=%(_RevitTfmMap.InnerTfm);RevitInnerTfm=%(_RevitTfmMap.OriginalTfm);$(_InnerBuildProperties)">
            <Output TaskParameter="TargetOutputs" ItemName="NativeManifest"/>
        </MSBuild>
    </Target>

</Project>
