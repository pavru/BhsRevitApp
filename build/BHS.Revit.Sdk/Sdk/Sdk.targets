<Project>

    <!--
      The Revit moniker is made whole before the base SDK is imported, and then the base SDK does
      all the rest: cross-targeting, restore, compilation, design-time builds. Nothing here
      intercepts Build, Restore or any design-time target, which is the point - an outer build that
      dispatches into a child MSBuild call is invisible to an IDE, and that is what made Rider show
      these projects with one bogus framework and no source files.
    -->
    <PropertyGroup>
        <_RevitTargetsDir>$(MSBuildThisFileDirectory)targets\</_RevitTargetsDir>
    </PropertyGroup>

    <Import Project="$(_RevitTargetsDir)Revit.Identity.targets" Condition="Exists('$(_RevitTargetsDir)Revit.Identity.targets')"/>

    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk"/>

    <!-- Kept as the name the publishing targets use to exclude the cross-targeting build, where
         there is no single framework to publish and RevitVersion is empty. -->
    <PropertyGroup>
        <IsRevitOuterBuild Condition="'$(IsCrossTargetingBuild)' == 'true'">true</IsRevitOuterBuild>
    </PropertyGroup>

    <Import Project="$(_RevitTargetsDir)Revit.Validation.targets" Condition="'$(IsRevitTfm)' == 'true' And Exists('$(_RevitTargetsDir)Revit.Validation.targets')"/>
    <Import Project="$(_RevitTargetsDir)Revit.Tasks.targets" Condition="Exists('$(_RevitTargetsDir)Revit.Tasks.targets')"/>
    <Import Project="$(_RevitTargetsDir)Revit.Publish.targets" Condition="Exists('$(_RevitTargetsDir)Revit.Publish.targets')"/>

</Project>
