<Project>

    <!-- Loaded before Microsoft.NET.Sdk. Nothing here may depend on TargetFramework: in a
         cross-targeting outer build it is empty, and in a single-targeting project that declares
         it in the body it is not visible yet. Everything Revit-specific therefore lives in
         targets/Revit.Identity.targets, which runs at the first point where the framework is
         known however it was supplied. -->

    <PropertyGroup>
        <SupportedTargetFrameworks>$(SupportedTargetFrameworks);net48-revit2024;net8.0-revit2025;net8.0-revit2026;net10.0-revit2027</SupportedTargetFrameworks>
    </PropertyGroup>

    <!--
      A Revit framework resolves packages and project references through AssetTargetFallback, and
      NU1701/NU1702 are the notices that it did. They are the design working, not something anyone
      can act on.

      This is one of the few things that cannot wait for Revit.Identity.targets, and it cannot be
      conditioned on the framework at all: NuGet records the warning properties once per project,
      taken from the cross-targeting outer build, which has no Revit framework of its own. Written
      conditionally the warnings escaped to the solution level, where nothing suppressed them.

      NU1202 is deliberately not in this list - see Revit.Identity.targets.
    -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);NU1701;NU1702</NoWarn>
    </PropertyGroup>

    <!-- Where the SDK's own MSBuild tasks live. The package carries both flavours because MSBuild
         runs either on .NET Framework (Visual Studio, Rider) or on .NET (dotnet build). -->
    <PropertyGroup>
        <BuildTasksDirectoryRoot>$(MSBuildThisFileDirectory)..\..\tasks\</BuildTasksDirectoryRoot>
        <BuildTasksTFM Condition=" '$(MSBuildRuntimeType)' == 'Core'">net10.0</BuildTasksTFM>
        <BuildTasksTFM Condition=" '$(BuildTasksTFM)' == ''">net48</BuildTasksTFM>
        <BuildTasksDirectory>$(BuildTasksDirectoryRoot)$(BuildTasksTFM)\</BuildTasksDirectory>
        <BuildTasksAssembly>$(BuildTasksDirectory)BHS.Revit.Sdk.dll</BuildTasksAssembly>
    </PropertyGroup>

</Project>
