<Project>

    <!-- Loaded after Microsoft.NET.Sdk's own props, so Directory.Build.props and
         Directory.Packages.props have already been read. Still no TargetFramework here - see the
         note in Before.Microsoft.NET.Sdk.props. -->

    <PropertyGroup Condition="'$(UseWinUI)' == 'true'">
        <TargetPlatformMinVersion Condition="'$(TargetPlatformMinVersion)' == ''">10.0.17763.0</TargetPlatformMinVersion>
        <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">win10-x64</RuntimeIdentifiers>
        <EnableMsixTooling Condition="'$(EnableMsixTooling)' == ''">true</EnableMsixTooling>
    </PropertyGroup>

    <!--
      Under Central Package Management the implicit Revit API references come with a floating
      PackageVersion pinned to the Revit release, and NuGet rejects a floating version on a
      PackageVersion item with NU1011 unless this is on.

      It belongs here rather than next to the package items: restore validates the collected items
      in the cross-targeting outer build, which has no Revit framework of its own and therefore
      never reaches targets/Revit.Packages.targets.

      It is a default: set the property in Directory.Build.props to take the decision away from the
      SDK. Note this permits floating central versions for the whole project, including ones the
      project declares itself.
    -->
    <PropertyGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true' And '$(CentralPackageFloatingVersionsEnabled)' == ''">
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    </PropertyGroup>

</Project>
