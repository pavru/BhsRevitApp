<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Side-agnostic code. Targets the plain .NET axis, not the Revit one: it is consumed by
      Revit-side assemblies and by Win-side processes alike, so it must not know a Revit version.
      The lowest target is net48 because Revit 2024 is in support.
    -->
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
        <RootNamespace>BHS.Shared</RootNamespace>
    </PropertyGroup>

</Project>
