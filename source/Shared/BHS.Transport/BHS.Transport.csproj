<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The channel between Revit-side and Win-side. Side-agnostic on purpose: both ends host a
      server and both call the other, so there is one assembly rather than a matched pair.

      Windows-only, and says so: named pipe descriptors and process inspection are Windows APIs,
      and a plain net8.0 assembly calling them is a CA1416 waiting to happen. Nothing is lost by
      admitting it - Revit is Windows-only and so is Win-side.

      Revit projects reach it through the ordinary nearest-framework negotiation, measured rather
      than assumed: net48-revit2024 binds net48, both net8.0-revit TFMs bind net8.0-windows, and
      net10.0-revit2027 binds net10.0-windows. It is restored once, on its own terms.
    -->

    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <RootNamespace>BHS.Transport</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!--
          The vendored rebuild rather than the package. Its readme carries the measurement: the
          published net462 build is compiled against a System.Memory that Grpc.Core.Api is not,
          and inside Revit 2024 that is fatal with no way to write the binding redirect that would
          reconcile them.
        -->
        <ProjectReference Include="..\BHS.Grpc.NamedPipes\BHS.Grpc.NamedPipes.csproj"/>
        <PackageReference Include="Grpc.Tools" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protocol\framework.proto" GrpcServices="Both"/>
    </ItemGroup>

</Project>
