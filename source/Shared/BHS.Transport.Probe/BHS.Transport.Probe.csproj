<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Runs a real conversation over a real named pipe and reports what worked. Not a unit test: it
      exists because the choice of transport was made by reading metadata, and a claim that gRPC
      framing over a named pipe carries server streaming on .NET Framework 4.8 is worth nothing
      until something has actually done it.

      It targets all three plain frameworks so every Revit leg is covered - net48 is Revit 2024,
      net8.0 is 2025 and 2026, net10.0 is 2027 - and it is meant to be run once per framework with
      `dotnet run`, passing the framework with -f. The command line is in the repository readme
      section on the transport; it cannot be written here, because an XML comment may not contain
      a double dash.

      Exit code is the number of failed checks.
    -->

    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>BHS.Transport.Probe</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\BHS.Transport\BHS.Transport.csproj"/>
    </ItemGroup>

</Project>
