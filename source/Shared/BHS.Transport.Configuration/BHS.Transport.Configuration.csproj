<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Reads what the other side publishes as ordinary configuration.

      Kept apart from BHS.Transport on purpose. Publishing needs no configuration library at all,
      and the publisher is Revit-side, where every assembly lands in the AppDomain shared with
      every other vendor's add-in on Revit 2024. Whoever only publishes should not have to carry
      Microsoft.Extensions.Configuration and its dependencies in there.
    -->

    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <RootNamespace>BHS.Transport.Configuration</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BHS.Transport\BHS.Transport.csproj"/>
    </ItemGroup>

</Project>
