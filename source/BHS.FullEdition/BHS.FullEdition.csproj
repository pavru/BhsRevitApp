<Project Sdk="BHS.Revit.Sdk/1.6.2">

    <!--
      An edition: the add-in Revit actually loads, and the thinnest thing this framework allows.

      It writes one class for the host - who it is, which features it offers, which tab they go on -
      and references each feature's Entry project. Nothing else: the composition is the host's, the
      work is the feature's, and the buttons, the entry points Revit constructs and the availability
      classes come with the feature's Entry assembly, so that the next edition offering the same
      feature writes none of them again.

      UseWPF because BHS.Revit.Host has it, for the placeholder icons. It costs nothing in the
      output: PresentationCore lives in the GAC on net48 and in the shared framework on the .NET
      axis, and Revit's own interface is built on it.
    -->

    <PropertyGroup>
        <TargetFrameworks>net48-revit2024;net8.0-revit2025;net8.0-revit2026;net10.0-revit2027</TargetFrameworks>
        <RootNamespace>BHS.FullEdition</RootNamespace>
        <UseWPF>true</UseWPF>
        <PublishRevitAddIn>true</PublishRevitAddIn>
        <RevitPackageName>BHS.FullEdition</RevitPackageName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Revit\BHS.Revit.Host\BHS.Revit.Host.csproj" />
        <!--
          The cabling feature, through its Entry project, and the one reference does three jobs.

          It brings BHS.MEP.Cabling.Entry.dll into this folder with its manifest beside it - the
          manifest travels as a related file of the referenced assembly, see Directory.Build.targets -
          and the host builds those buttons only because Modules in FullEditionApplication lists
          CablingFeature.

          It brings the declaration, transitively, so that Modules can name CablingFeature. That
          assembly IS loaded at startup, on purpose, because it carries what the application has to
          know before anybody uses cabling; it is allowed to be, because it is forbidden to reference
          anything that does work - RVTDEC001 checks the built assembly rather than trusting the rule.

          And it brings the feature itself, transitively, which this project names nowhere. That does
          not load it: the CLR resolves an entry point's base, and the feature with it, when Revit
          first constructs the entry point on a press. Measured on all four releases in the probe,
          first for an entry point in the edition's own assembly, and on 2026-09-14 for one in an Entry
          assembly that Revit had already loaded to ask availability: the feature came in only with the
          press, two seconds and more after the rule was asked.
        -->
        <ProjectReference Include="..\Features\MEP.Cabling\BHS.MEP.Cabling.Entry\BHS.MEP.Cabling.Entry.csproj" />
    </ItemGroup>

    <ItemGroup>
        <RevitAddIn Include="BHS.FullEdition.addin">
            <AddInType>Application</AddInType>
            <AddInName>BHS Full Edition</AddInName>
            <FullClassName>BHS.FullEdition.FullEditionApplication</FullClassName>
            <AddInId>3f8b1d64-9c27-4a5e-8d13-6e0a72c4f5b1</AddInId>
            <VendorId>$(RevitVendorId)</VendorId>
            <VendorDescription>$(RevitVendorDescription)</VendorDescription>
            <Description>BimHouse Software: the full edition.</Description>
        </RevitAddIn>
    </ItemGroup>

</Project>
