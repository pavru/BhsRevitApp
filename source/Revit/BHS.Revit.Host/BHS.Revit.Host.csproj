<Project Sdk="BHS.Revit.Sdk/1.3.7">

    <!--
      The Revit-side host: the entry point an edition derives from, and everything that has to
      happen between Revit calling OnStartup and a feature being usable.

      Separate from BHS.Revit.Abstractions on purpose. A feature references the contracts and never
      this: otherwise the dependency direction is respected on paper while features quietly learn
      the host's insides, and the host stops being replaceable. That is also why HostRegistry lives
      in the contracts - a command Revit constructed has to find its host without referencing it.
    -->

    <PropertyGroup>
        <TargetFrameworks>net48-revit2024;net8.0-revit2025;net8.0-revit2026;net10.0-revit2027</TargetFrameworks>
        <RootNamespace>BHS.Revit.Host</RootNamespace>
        <UseRevitApi>true</UseRevitApi>
        <UseRevitApiUi>true</UseRevitApiUi>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\BHS.Revit.Abstractions\BHS.Revit.Abstractions.csproj"/>
        <ProjectReference Include="..\BHS.Revit.Common\BHS.Revit.Common.csproj"/>
    </ItemGroup>

</Project>
