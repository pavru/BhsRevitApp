<Project Sdk="BHS.Revit.Sdk/1.5.2">

    <!--
      The Revit-side host: the entry point an edition derives from, and everything that has to
      happen between Revit calling OnStartup and a feature being usable.

      Separate from BHS.Revit.Abstractions on purpose. A feature references the contracts and never
      this: otherwise the dependency direction is respected on paper while features quietly learn
      the host's insides, and the host stops being replaceable. That is also why HostRegistry lives
      in the contracts - a command Revit constructed has to find its host without referencing it.
    -->

    <PropertyGroup>
        <TargetFrameworks>net48-revit2024;net8.0-revit2025;net8.0-revit2026;net10.0-revit2027</TargetFrameworks>
        <RootNamespace>BHS.Revit.Host</RootNamespace>
        <UseRevitApi>true</UseRevitApi>
        <UseRevitApiUi>true</UseRevitApiUi>

        <!--
          For ImageSource on a ribbon button, and nothing else - no XAML here. It costs nothing in
          the AppDomain: PresentationCore and its neighbours are in the GAC on net48 and in the
          Windows Desktop shared framework on the .NET axis, and Revit's own interface is WPF, so
          they are loaded long before we ask. RefCheck confirms the output is unchanged.
        -->
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Embedded rather than deployed. A file beside the assembly would need a path resolved at run
          time, would have to survive publishing and deployment, and would outlive whatever produced
          it - deployment here copies and never deletes, which has already left stale assemblies in
          add-in folders. An icon inside the assembly cannot go missing or go stale.
        -->
        <EmbeddedResource Include="Resources\PlaceholderIcon.16.png"/>
        <EmbeddedResource Include="Resources\PlaceholderIcon.32.png"/>

        <!-- The source the two PNGs were rendered from, kept so they can be made again. -->
        <None Include="Resources\PlaceholderIcon.svg"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BHS.Revit.Abstractions\BHS.Revit.Abstractions.csproj"/>
        <ProjectReference Include="..\BHS.Revit.Common\BHS.Revit.Common.csproj"/>
    </ItemGroup>

</Project>
