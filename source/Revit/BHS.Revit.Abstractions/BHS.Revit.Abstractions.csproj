<Project Sdk="BHS.Revit.Sdk/1.6.0">

    <!--
      Contracts the rest of the Revit side is written against. Multi-targets the Revit axis
      because the contracts mention Revit API types; implementations that differ between
      releases stay behind these interfaces.
    -->
    <PropertyGroup>
        <TargetFrameworks>net48-revit2024;net8.0-revit2025;net8.0-revit2026;net10.0-revit2027</TargetFrameworks>
        <RootNamespace>BHS.Revit.Abstractions</RootNamespace>
        <UseRevitApi>true</UseRevitApi>
        <UseRevitApiUi>true</UseRevitApiUi>
        <!--
          For FrameworkElement in IPaneContent, and nothing else. It costs nothing in the AppDomain:
          PresentationFramework is in the GAC on net48 and in the Windows Desktop shared framework on
          the .NET axis, and Revit's own interface is WPF, so it is loaded long before we ask. The base
          SDK's check on projects that merely reference this one is silenced by our SDK for the revit
          platform, so declarations and Entry assemblies do not need UseWPF for it.
        -->
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Shared\BHS.Shared\BHS.Shared.csproj" />
        <!-- A feature is handed settings and a log and nothing else, so the contract for them
             belongs here. Both are package-free by design; see their readmes. -->
        <ProjectReference Include="..\..\Shared\BHS.Settings\BHS.Settings.csproj"/>
        <ProjectReference Include="..\..\Shared\BHS.Logging\BHS.Logging.csproj"/>
    </ItemGroup>

</Project>
