<Window x:Class="BHS.MEP.Cabling.Ui.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="clr-namespace:BHS.MEP.Cabling.Ui"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance ui:ReviewViewModel}"
        Title="Cable lengths"
        Width="620"
        MaxHeight="620"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
      Plain, like the routing window and for the same reason: the look belongs with the dockable
      pane, where WPF-UI gets measured inside a live Revit for the first time.

      What is here is only what the check has to say: what it is doing, what it found, one line per
      circuit whose stored length stopped being true, and the one thing it can do about it.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Shown" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding What}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Visibility="{Binding IsBusy, Converter={StaticResource Shown}}" />

        <ProgressBar Grid.Row="1"
                     Height="6"
                     Margin="0,12,0,0"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource Shown}}" />

        <TextBlock Grid.Row="2"
                   Text="{Binding Summary}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Visibility="{Binding IsFinished, Converter={StaticResource Shown}}" />

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Text="{Binding Failure}"
                   TextWrapping="Wrap"
                   Foreground="#B00020"
                   Visibility="{Binding HasFailure, Converter={StaticResource Shown}}" />

        <!-- Selectable text rather than labels: these lines carry element ids, and the first thing
             anybody does with one is paste it into Revit's own "select by ID". -->
        <ListBox Grid.Row="4"
                 Margin="0,12,0,0"
                 MinHeight="80"
                 ItemsSource="{Binding Lines}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Visibility="{Binding HasLines, Converter={StaticResource Shown}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="5"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Select in model"
                    MinWidth="140"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding CanSelect}"
                    Click="OnSelect" />

            <Button Content="Close"
                    MinWidth="96"
                    Padding="12,6"
                    IsCancel="True"
                    Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
