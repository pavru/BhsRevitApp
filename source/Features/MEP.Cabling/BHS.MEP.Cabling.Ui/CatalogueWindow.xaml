<Window x:Class="BHS.MEP.Cabling.Ui.CatalogueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="clr-namespace:BHS.MEP.Cabling.Ui"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance ui:CatalogueViewModel}"
        Title="Carrier catalogue"
        Width="760"
        MaxHeight="620"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
      Plain, like the routing and lengths windows and for the same reason: the look belongs with the
      dockable pane, where WPF-UI is measured inside a live Revit.

      What is here is only what the rule needs: which category, what its elements count as, what
      they have to say about themselves - and, beside each rule while it is written, how many
      elements it actually admits. That last column is the point of the screen: a rule matching
      nothing looks exactly like a model holding nothing, everywhere except here.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Shown" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Text="Which of this model's elements carry cable. These rules belong to the model, so everyone who opens it gets the same answer. An empty parameter counts the whole category; an empty value counts every type that filled the parameter in with anything." />

        <DataGrid Grid.Row="1"
                  Margin="0,12,0,0"
                  MinHeight="160"
                  ItemsSource="{Binding Rules}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category"
                                    Width="190"
                                    IsReadOnly="True"
                                    Binding="{Binding Name}" />

                <DataGridTextColumn Header="Counts as"
                                    Width="110"
                                    Binding="{Binding Class}" />

                <DataGridTextColumn Header="Type parameter"
                                    Width="170"
                                    Binding="{Binding Parameter}" />

                <DataGridTextColumn Header="Equal to"
                                    Width="140"
                                    Binding="{Binding Value}" />

                <DataGridTextColumn Header="In this model"
                                    Width="*"
                                    IsReadOnly="True"
                                    Binding="{Binding Tally}" />

                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove"
                                    Margin="4,2"
                                    Padding="8,2"
                                    Click="OnRemove" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Loud, and where the mistake is being made. Revit's own warning mechanism cannot carry
             this: the registered text is all it shows, so it could not name the category, and there
             is no element to point it at. -->
        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="#B3261E"
                   Text="{Binding Warning}"
                   Visibility="{Binding HasWarning, Converter={StaticResource Shown}}" />

        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Add a category:" />

            <ComboBox Margin="8,0,0,0"
                      Width="240"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Name"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding Chosen, Mode=TwoWay}" />

            <Button Margin="8,0,0,0"
                    Padding="12,3"
                    Content="Add"
                    IsEnabled="{Binding CanAdd}"
                    Click="OnAdd" />

            <Button Margin="16,0,0,0"
                    Padding="12,3"
                    Content="Count again"
                    Click="OnRecount" />

            <Button Margin="8,0,0,0"
                    Padding="12,3"
                    Content="Restore the shipped set"
                    Click="OnRestore" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding Saved}"
                   Visibility="{Binding HasSaved, Converter={StaticResource Shown}}" />

        <StackPanel Grid.Row="5"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Padding="16,4"
                    Content="Save into the model"
                    IsEnabled="{Binding CanSave}"
                    Click="OnSave" />

            <Button Margin="8,0,0,0"
                    Padding="16,4"
                    Content="Close"
                    IsCancel="True"
                    Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
