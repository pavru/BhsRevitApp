<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Routing, as a value. No Autodesk reference, and that is the load-bearing part rather than a
      preference: this project is where the search runs, and the search runs on a background thread.

      A modal Revit command owns the API thread, which is also Revit's UI thread - so work done on it
      freezes Revit and freezes our own window with it, and a progress bar that cannot repaint is
      worse than none. The pump does not help either: an ExternalEvent raised from inside a modal
      window never fires, because Revit never reaches Idling while the window is up. The compute
      phase therefore has to happen off the API thread and touch nothing of Revit's.

      "Touch nothing of Revit's" is a rule somebody eventually breaks, so it is not left to
      discipline: on this axis the type Document does not exist. A missing field in the snapshot
      stops being a Revit that hangs in front of a customer and becomes an error at build time, in
      the hour it is written. The same split was chosen to make the routing debuggable without
      Revit; it turns out to be the thread guarantee as well.
    -->

    <PropertyGroup>
        <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
        <RootNamespace>BHS.MEP.Cabling.Routing</RootNamespace>
    </PropertyGroup>

</Project>
