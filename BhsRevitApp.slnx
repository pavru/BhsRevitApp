<Solution>

  <Configurations>
    <Platform Name="x64" />
  </Configurations>

  <!--
    Build tooling. These build before anything else can restore: BHS.Revit.Sdk has to be packed
    into artifacts/feed for the source projects to resolve their SDK at all.
  -->
  <Folder Name="/build/">
    <Project Path="build/BHS.Revit.Sdk/BHS.Revit.Sdk.csproj" Type="C#" />
    <Project Path="build/RefCheck/RefCheck.csproj" Type="C#" />
  </Folder>

  <!-- Repository-level files, so they are editable without leaving the solution. -->
  <Folder Name="/config/">
    <File Path="CLAUDE.md" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="NuGet.config" />
    <File Path="global.json" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
  </Folder>

  <!-- Side-agnostic code: plain .NET axis, knows nothing about a Revit version. -->
  <Folder Name="/Shared/">
    <Project Path="source/Shared/BHS.Shared/BHS.Shared.csproj" Type="C#" />
    <!-- GrpcDotNetNamedPipes, vendored and rebuilt so its System.Memory reference matches the
         one Revit 2024 ships. Its readme carries the measurement. -->
    <Project Path="source/Shared/BHS.Grpc.NamedPipes/BHS.Grpc.NamedPipes.csproj" Type="C#" />
    <!-- The layered settings both sides read from disk, so neither waits for the other to start.
         No packages at all, and a hand-written reader: it is the half that goes inside Revit. -->
    <Project Path="source/Shared/BHS.Settings/BHS.Settings.csproj" Type="C#" />
    <!-- Logging, package-free for the same reason: every mainstream logging library is already
         loaded in the Revit process, in incompatible versions at once. -->
    <Project Path="source/Shared/BHS.Logging/BHS.Logging.csproj" Type="C#" />
    <!-- The same files as an IConfigurationSource, for the side that may carry
         Microsoft.Extensions.Configuration. Win-side only, on purpose. -->
    <Project Path="source/Shared/BHS.Settings.Configuration/BHS.Settings.Configuration.csproj" Type="C#" />
    <Project Path="source/Shared/BHS.Transport/BHS.Transport.csproj" Type="C#" />
    <Project Path="source/Shared/BHS.Transport.Configuration/BHS.Transport.Configuration.csproj" Type="C#" />
    <Project Path="source/Shared/BHS.Transport.Probe/BHS.Transport.Probe.csproj" Type="C#" />
  </Folder>

  <!-- Win-side: separate processes that know about Revit but are never loaded into it. -->
  <Folder Name="/WinSide/">
    <!-- Starts a Revit and waits to be told it is ready. Extracted from the probe runner, which
         is still its test - four live releases beat any argument about how it should behave. -->
    <Project Path="source/WinSide/BHS.Revit.Launch/BHS.Revit.Launch.csproj" Type="C#" />
    <!-- The companion process itself: serves the channel, keeps the register, starts and stops
         Revit on request. A user process rather than a service - Revit needs a desktop. -->
    <Project Path="source/WinSide/BHS.WinSide/BHS.WinSide.csproj" Type="C#" />
  </Folder>

  <!-- Features: the plugins themselves. Routing is on the plain axis and knows nothing of Revit -
       that is what lets it run off the API thread, which a modal command owns. -->
  <Folder Name="/Features/">
    <Project Path="source/Features/MEP.Cabling/BHS.MEP.Cabling.Routing/BHS.MEP.Cabling.Routing.csproj" Type="C#" />
  </Folder>

  <!-- Revit-side framework: loaded into the Revit process, multi-targeted on the Revit axis. -->
  <Folder Name="/Revit/">
    <Project Path="source/Revit/BHS.Revit.Abstractions/BHS.Revit.Abstractions.csproj" Type="C#" />
    <Project Path="source/Revit/BHS.Revit.Common/BHS.Revit.Common.csproj" Type="C#" />
    <!-- The entry point an edition derives from, and everything between OnStartup and a usable
         feature. Separate from Abstractions so that features never learn the host's insides. -->
    <Project Path="source/Revit/BHS.Revit.Host/BHS.Revit.Host.csproj" Type="C#" />

    <!-- The verification pair: an add-in that reports what it sees, and the runner that starts
         Revit and asks it. The runner is not loaded into Revit and is not on the Revit axis; it
         sits here because the two halves are one instrument. -->
    <Project Path="source/Revit/BHS.Revit.Probe/BHS.Revit.Probe.csproj" Type="C#" />
    <!-- A stand-in feature: one command, referencing the contracts and never the host. It exists so
         that "the feature loads only when its button is pressed" is measured rather than assumed. -->
    <Project Path="source/Revit/BHS.Revit.Probe.Feature/BHS.Revit.Probe.Feature.csproj" Type="C#" />
    <Project Path="source/Revit/BHS.Revit.Probe.Runner/BHS.Revit.Probe.Runner.csproj" Type="C#" />
  </Folder>

</Solution>
